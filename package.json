{
  "name": "envlock",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "api",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:api": "npm run build -w api",
    "build:cli": "npm run build -w packages/cli",
    "dev:api": "npm run start:dev -w api",
    "dev:cli": "npm run start:dev -w packages/cli",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start:api": "npm run start -w api",
    "start:cli": "npm run start -w packages/cli",
    "test": "npm run test:api && npm run test:cli",
    "test:api": "npm test -w api",
    "test:cli": "npm test -w packages/cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0"
  }
}
