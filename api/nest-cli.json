{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "frontend/**/*.html"
      },
      {
        "include": "frontend/assets/**/*"
      }
    ],
    "deleteOutDir": true
  }
}
