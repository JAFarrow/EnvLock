# Copy this file to api/.env for local API development.
# Generate a real encryption key with: openssl rand -base64 32

NODE_ENV=development
PORT=3000
LOG_FORMAT=pretty

DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=
JWT_ACCESS_TOKEN_COOKIE_NAME=

# Valid dummy value for local shape only. Replace before using real secrets.
SECRET_ENCRYPTION_KEY_BASE64=
SECRET_ENCRYPTION_KEY_VERSION=
